<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  Full regression suite. Package-scoped <test> blocks keep the Allure/TestNG report readable
  (results grouped as "Manager Tests" / "Customer Tests"); use -Dgroups=smoke on the CLI for a
  quick subset instead of maintaining a second suite file.
-->
<suite name="XYZ Bank Automation Suite" verbose="1">
    <listeners>
        <listener class-name="com.xyzbank.listeners.AllureTestListener"/>
        <listener class-name="com.xyzbank.listeners.AllureEnvironmentWriter"/>
        <listener class-name="com.xyzbank.listeners.RetryTransformer"/>
    </listeners>

    <test name="Manager Tests">
        <packages>
            <package name="com.xyzbank.tests.manager"/>
        </packages>
    </test>

    <test name="Customer Tests">
        <packages>
            <package name="com.xyzbank.tests.customer"/>
        </packages>
    </test>
</suite>
